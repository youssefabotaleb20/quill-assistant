# Copy to .env at the repo root (never commit it) and start uvicorn with --env-file ../.env,
# or set these in your host's dashboard.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Front-end origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:8000,https://youssefabotaleb20.github.io
QUESTIONS_PER_HOUR=30
