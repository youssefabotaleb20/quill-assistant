# Copy to .env at the repo root (never commit it) and start uvicorn with --env-file ../.env,
# or set these in your host's dashboard.
# Optional server-side key. Leave it unset so visitors use their own key.
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Extra front-end origins allowed to call the API (only needed if the front end is hosted elsewhere).
CORS_ORIGINS=http://localhost:8000
QUESTIONS_PER_HOUR=30
